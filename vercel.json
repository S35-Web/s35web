{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/qr/:code", "destination": "/api/qr?code=:code" }
  ],
  "redirects": [
    { "source": "/producto-waxtard-perla", "destination": "/productos/waxtard-blanco-perla", "permanent": true },
    { "source": "/producto-waxtard-perla.html", "destination": "/productos/waxtard-blanco-perla", "permanent": true },
    { "source": "/producto-waxtard-extra-anclaje", "destination": "/productos/waxtard-extra-anclaje", "permanent": true },
    { "source": "/producto-waxtard-extra-anclaje.html", "destination": "/productos/waxtard-extra-anclaje", "permanent": true },
    { "source": "/producto-cemento-plastico-concreto", "destination": "/productos/cemento-plastico-concreto", "permanent": true },
    { "source": "/producto-cemento-plastico-concreto.html", "destination": "/productos/cemento-plastico-concreto", "permanent": true },
    { "source": "/productos/cellbond-pro", "destination": "/productos", "permanent": true },
    { "source": "/productos/cellbond-pro.html", "destination": "/productos", "permanent": true }
  ]
}
